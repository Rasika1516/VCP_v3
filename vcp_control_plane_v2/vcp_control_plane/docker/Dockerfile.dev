# =============================================================================
# VCP Control Plane — Development-only Dockerfile (no frontend build)
# Mounts the src/ tree at runtime for hot-reload.
# =============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src/ ./src/

RUN pip install --no-cache-dir -e ".[dev]"

COPY alembic.ini ./
COPY alembic/ ./alembic/

EXPOSE 9000

CMD ["vcp-control", "run", "--reload"]

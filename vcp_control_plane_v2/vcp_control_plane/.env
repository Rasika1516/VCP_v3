# =============================================================================
# VCP Control Plane — Environment Variables
# =============================================================================
# Copy to .env and fill in values. All vars are prefixed VCP_CP_.

# --- API ---
VCP_CP_API_HOST=0.0.0.0
VCP_CP_API_PORT=8090
VCP_CP_API_TOKEN=change-me-in-production
VCP_CP_REQUIRE_AUTH=true

# --- PostgreSQL ---
VCP_CP_DATABASE_URL=postgresql+asyncpg://vcp:vcp@localhost:5432/vcp_control

# --- Redis (must match vcp_data_plane config) ---
VCP_CP_REDIS_HOST=localhost
VCP_CP_REDIS_PORT=6379
VCP_CP_REDIS_PASSWORD=
VCP_CP_REDIS_SSL=false

# --- Command Bus (stream key prefixes — must match data plane) ---
VCP_CP_COMMAND_STREAM_PREFIX=vcp:commands:worker
VCP_CP_BROADCAST_STREAM=vcp:commands:broadcast
VCP_CP_EVENT_STREAM_PREFIX=vcp:events:worker
VCP_CP_CONSUMER_GROUP=control-plane
VCP_CP_CONSUMER_NAME=cp-01

# --- Data-plane workers NOT deployed from the UI (optional) ---
# Preferred: explicit id=url pairs (worker_id must match the worker's worker.yaml)
VCP_CP_WORKERS=
# Legacy: URLs only — worker IDs are resolved via GET <url>/health
VCP_CP_WORKER_URLS=
VCP_CP_WORKER_TOKEN=
# Discover workers by scanning Redis for vcp:events:worker:* streams
VCP_CP_EVENT_STREAM_DISCOVERY=true
VCP_CP_EVENT_STREAM_REFRESH_S=5

# --- VCP Fleets: generated worker configs + deployment ---
VCP_CP_FLEET_CONFIG_DIR=var/fleets
# Data-plane profile YAMLs usable by fleets (in addition to the profile registry)
VCP_CP_WORKER_PROFILES_DIR=../vcp_data_plane/configs/profiles
# Default launcher for new fleets: process | docker
VCP_CP_DEFAULT_LAUNCHER=process
# process launcher — command that starts a worker (vcp_data_plane must be installed)
VCP_CP_WORKER_COMMAND=vcp-worker
VCP_CP_WORKER_HOST=127.0.0.1
VCP_CP_WORKER_API_PORT_START=8100
VCP_CP_WORKER_METRICS_PORT_START=9300
# Redis as seen from the worker (blank = VCP_CP_REDIS_HOST / PORT)
VCP_CP_WORKER_REDIS_HOST=
VCP_CP_WORKER_REDIS_PORT=0
# docker launcher
VCP_CP_DOCKER_SOCKET=/var/run/docker.sock
VCP_CP_DOCKER_IMAGE=vcp-data-plane:latest
# "" = default bridge + published ports | "host" | <user-defined network shared with the control plane>
VCP_CP_DOCKER_NETWORK=
# host path of VCP_CP_FLEET_CONFIG_DIR, when the control plane itself runs in a container
VCP_CP_DOCKER_HOST_FLEET_DIR=

# --- Frontend CORS origin ---
VCP_CP_FRONTEND_URL=http://localhost:5173

# --- Misc ---
VCP_CP_LOG_LEVEL=INFO
VCP_CP_PROFILE_DIR=configs/profiles
